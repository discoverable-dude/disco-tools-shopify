# Base URL of the platform edge functions, e.g. https://<project>.supabase.co/functions/v1
DISCO_TOOLS_API_URL=https://tools.example.com
# Shared HMAC secret, same value on the platform
DISCO_TOOLS_API_SECRET=change-me

# Passcode for the Agency tools page (/app/agency). Required to use it.
AGENCY_PASSCODE=choose-a-passcode
# Base URL of Discoverable Tools, for the "open this client" link
DISCO_TOOLS_APP_URL=https://tools.example.com
# Optional branding (see app/brand.ts)
BRAND_ACCENT=#111827
BRAND_ACCENT_TEXT=#ffffff
BRAND_LOGO_URL=
BRAND_CONTACT_EMAIL=
BRAND_BOOKING_URL=
