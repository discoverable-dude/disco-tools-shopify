# --- Shopify (set by `shopify app dev`; set manually on Vercel) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,write_products,read_orders,read_customers,read_inventory,read_content,write_content,read_online_store_navigation,read_markets
SHOPIFY_APP_URL=https://your-app.vercel.app

# --- Database (Postgres). DATABASE_URL = pooled, DATABASE_URL_UNPOOLED = direct (for migrations) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Encrypts client app secrets stored in the database (generate with: openssl rand -hex 32) ---
APP_ENCRYPTION_KEY=

# --- Discoverable Tools platform ---
# Base URL of the platform edge functions, e.g. https://<project>.supabase.co/functions/v1
DISCO_TOOLS_API_URL=
# Shared HMAC secret, same value on the platform (generate with: openssl rand -hex 32)
DISCO_TOOLS_API_SECRET=
# Base URL of Discoverable Tools, for the "open this client" link
DISCO_TOOLS_APP_URL=

# --- Agency tools page (/app/agency) ---
AGENCY_PASSCODE=

# --- Optional branding overrides (defaults come from discoverable.co.uk, see app/brand.ts) ---
BRAND_ACCENT=
BRAND_ACCENT_TEXT=
BRAND_LOGO_URL=
BRAND_CONTACT_EMAIL=
BRAND_BOOKING_URL=
