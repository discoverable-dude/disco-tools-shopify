generator client {
  provider = "prisma-client-js"
}

// Postgres everywhere (Vercel has no persistent disk). DATABASE_URL should be the
// pooled connection string; DATABASE_URL_UNPOOLED the direct one, used by migrations (Neon's Vercel integration creates both).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// One row per installed client store, mapped to a client in Discoverable Tools.
model ShopLink {
  shop             String    @id
  clientSlug       String?
  platformClientId String?
  status           String    @default("installed") // installed | linked | uninstalled
  installedAt      DateTime  @default(now())
  linkedAt         DateTime?
  uninstalledAt    DateTime?
  lastSyncAt       DateTime?
  lastSyncStatus   String?
}

// Outbox of Shopify webhook events waiting to be (or already) delivered to the platform.
model WebhookEvent {
  id          String    @id @default(cuid())
  shop        String
  topic       String
  webhookId   String?
  payload     String
  status      String    @default("pending") // pending | delivered | failed
  attempts    Int       @default(0)
  lastError   String?
  receivedAt  DateTime  @default(now())
  deliveredAt DateTime?

  @@index([shop, receivedAt])
  @@index([status])
}

// Bulk export runs (products / orders / customers) and their delivery to the platform.
model SyncRun {
  id          String    @id @default(cuid())
  shop        String
  resource    String // products | orders | customers
  bulkOpId    String?
  status      String    @default("running") // running | delivering | completed | failed
  recordCount Int       @default(0)
  error       String?
  variant     String? // "basic" when the export fell back to a reduced set of fields
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([shop, startedAt])
  @@index([bulkOpId])
}

// Every change pushed from the platform into Shopify, with the previous values for rollback.
model PushAudit {
  id         String   @id @default(cuid())
  shop       String
  resource   String // product | collection
  resourceId String
  changes    String // JSON of applied fields
  previous   String // JSON of values before the change
  status     String // applied | failed | rolled_back
  error      String?
  createdAt  DateTime @default(now())

  @@index([shop, createdAt])
}

// Shopify app credentials per client store, so one deployment can serve many custom apps.
// The secret is stored AES-256-GCM encrypted (key: APP_ENCRYPTION_KEY).
model AppCredential {
  shop            String   @id
  clientId        String
  clientSecretEnc String
  label           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Daily snapshot of the on-page SEO audit, so the dashboard can chart progress over time.
model SeoSnapshot {
  id                     String   @id @default(cuid())
  shop                   String
  takenAt                DateTime @default(now())
  score                  Int
  audited                Int
  withIssues             Int
  missingMetaTitle       Int
  missingMetaDescription Int
  missingAlt             Int
  duplicateTitles        Int

  @@index([shop, takenAt])
}

// Pre-computed 30 + 30 day sales report per store, built from the bulk orders export so it
// is accurate for stores with thousands of orders (live paging can only cover the latest few hundred).
model SalesSummary {
  shop       String   @id
  computedAt DateTime @default(now())
  payload    String // JSON, see app/sales-summary.server.ts
}

// Customer base report (cohorts, lifetime value, repeat rate) built from the bulk customers export.
model CustomerSummary {
  shop       String   @id
  computedAt DateTime @default(now())
  payload    String // JSON, see app/customer-summary.server.ts
}
