generator client {
  provider = "prisma-client-js"
}

// Postgres everywhere (Vercel has no persistent disk). DATABASE_URL should be the
// pooled connection string; DIRECT_URL the direct one, used by migrations.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// One row per installed client store, mapped to a client in Discoverable Tools.
model ShopLink {
  shop             String    @id
  clientSlug       String?
  platformClientId String?
  status           String    @default("installed") // installed | linked | uninstalled
  installedAt      DateTime  @default(now())
  linkedAt         DateTime?
  uninstalledAt    DateTime?
  lastSyncAt       DateTime?
  lastSyncStatus   String?
}

// Outbox of Shopify webhook events waiting to be (or already) delivered to the platform.
model WebhookEvent {
  id          String    @id @default(cuid())
  shop        String
  topic       String
  webhookId   String?
  payload     String
  status      String    @default("pending") // pending | delivered | failed
  attempts    Int       @default(0)
  lastError   String?
  receivedAt  DateTime  @default(now())
  deliveredAt DateTime?

  @@index([shop, receivedAt])
  @@index([status])
}

// Bulk export runs (products / orders / customers) and their delivery to the platform.
model SyncRun {
  id          String    @id @default(cuid())
  shop        String
  resource    String // products | orders | customers
  bulkOpId    String?
  status      String    @default("running") // running | delivering | completed | failed
  recordCount Int       @default(0)
  error       String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([shop, startedAt])
  @@index([bulkOpId])
}

// Every change pushed from the platform into Shopify, with the previous values for rollback.
model PushAudit {
  id         String   @id @default(cuid())
  shop       String
  resource   String // product | collection
  resourceId String
  changes    String // JSON of applied fields
  previous   String // JSON of values before the change
  status     String // applied | failed | rolled_back
  error      String?
  createdAt  DateTime @default(now())

  @@index([shop, createdAt])
}
